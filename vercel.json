{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/api/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "apps/web/package.json",
      "use": "@vercel/vite"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/apps/api/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/web/dist/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "/api",
    "NODE_ENV": "production"
  }
}
